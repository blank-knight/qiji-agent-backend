{
    "name": "qiji/qiji-admin",
    "description": "QIJI Agent 后端系统",
    "type": "project",
    "keywords": [
        "fastadmin",
        "thinkphp",
        "qiji",
        "agent"
    ],
    "require": {
        "php": ">=7.4.0",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-bcmath": "*",
        "ext-openssl": "*"
    },
    "config": {
        "autoloader": "composer",
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://mirrors.cloud.tencent.com/composer/"
        }
    }
}
